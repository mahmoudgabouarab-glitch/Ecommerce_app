APP_NAME=ShopSphere
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Database (XAMPP MySQL) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=shopsphere
DB_USERNAME=root
DB_PASSWORD=

# --- File-based drivers (no extra tables / services needed) ---
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# --- Sanctum ---
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1

# Uploaded images (products, avatars, banners, categories) are stored on
# Cloudinary so they survive container redeploys. Copy the single "API
# environment variable" from your Cloudinary dashboard.
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Paymob card payments. Create a sandbox account at paymob.com and copy these
# from the dashboard (Developers → API keys, Payment integrations, iframes).
# The webhook (transaction processed callback) should point at:
#   https://your-app.up.railway.app/api/paymob/webhook
PAYMOB_API_KEY=
PAYMOB_CARD_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=

# Transactional email is sent through the Brevo HTTP API (port 443), because
# most cloud hosts (Railway included) block outbound SMTP ports. Create a free
# key at brevo.com → SMTP & API → API Keys, and verify the sender address below.
BREVO_API_KEY=
MAIL_FROM_ADDRESS="no-reply@shopsphere.app"
MAIL_FROM_NAME="ShopSphere"
