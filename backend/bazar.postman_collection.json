        {
          "name": "Create Order (Checkout)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = pm.response.json();",
                  "var id = json && (json.id || (json.data && json.data.id));",
                  "if (id) { pm.collectionVariables.set('order_id', id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"address_id\": {{address_id}},\n  \"payment_method\": \"cash\",\n  \"coupon_code\": null\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/orders", "host": ["{{base_url}}"], "path": ["orders"] }
          }
        },
